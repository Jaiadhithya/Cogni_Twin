# Server-side only. The browser calls /api/... on the Next.js origin and the Route Handler
# at src/app/api/[...path]/route.ts forwards the request to the backend.

# Backend API base URL (default: http://localhost:8000/api/v1)
BACKEND_API_URL=http://localhost:8000/api/v1

# Sent as the X-API-Key header when the backend has API_KEY set.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
BACKEND_API_KEY=
